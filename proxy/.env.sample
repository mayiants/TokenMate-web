# ai-proxy-go 环境变量示例
# 实际运行时通过 ../ai-portal-go/.env.go-platform 提供，本文件仅作说明用途。
# 请勿将包含真实密钥的 .env 文件提交到 Git。

# Portal 地址（Docker 网络内）
PORTAL_URL=http://ai-portal-go:3001

# 与 Portal 同步使用的共享密钥（Portal 侧为 PROXY_SYNC_SECRET，Proxy 侧为 PORTAL_SYNC_SECRET）
PROXY_SYNC_SECRET=change-me-in-env-go-platform

# 加密 / 管理密钥（JWT_SECRET 已废弃：Proxy 不再本地验签 JWT，可留空）
ENCRYPTION_KEY=change-me
ADMIN_SECRET=change-me

# Proxy Redis 密码；若未设置则回退使用 Portal 的 REDIS_PASSWORD
PROXY_REDIS_PASSWORD=

# 服务器标识
SERVER_ID=
SERVER_REGION=

# 开发/模拟开关
PORTAL_DEV_MODE=false
SIMULATE_ENABLED=false
SIMULATE_LATENCY_MS=100

# TLS
REDIS_TLS=false
REDIS_TLS_SKIP_VERIFY=false

# 构建镜像时的代理
APK_MIRROR=dl-cdn.alpinelinux.org
GOPROXY=https://proxy.golang.org,direct
