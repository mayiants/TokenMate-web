# ============================================
# AI Proxy Go - Environment Template
# Copy this file to .env and fill in your values before running start.sh
# ============================================

# -----------------------------------------------------------------------------
# PORTAL CONNECTION
# -----------------------------------------------------------------------------
# Portal URL that Proxy connects to for sync, key validation, and webhook.
# Same-machine:  http://ai-portal-go:3001  (Docker network name)
# Distributed:   http://<portal-server-ip>:3001
PORTAL_URL=http://ai-portal-go:3001

# Dev mode: allows http:// Portal URLs (required for Docker/local dev).
# Set to false in production when using https://.
PORTAL_DEV_MODE=true

# -----------------------------------------------------------------------------
# REDIS (REQUIRED for production; memory-only is for debugging only)
# -----------------------------------------------------------------------------
# Proxy 独立使用的 Redis。生产环境必须与 Portal Redis 分离。
# 独立部署时，从 Portal 的 .env.go-platform 中拷贝 PROXY_REDIS_* 对应值到此处，
# 但变量名保持为 REDIS_*（ai-proxy-go 读取 REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB）。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Enable TLS for Redis. Local/dev: false. Production: true.
REDIS_TLS=false
REDIS_TLS_SKIP_VERIFY=false

# -----------------------------------------------------------------------------
# PROXY INSTANCE IDENTITY (for distributed / multi-region deployment)
# -----------------------------------------------------------------------------
# Server instance ID. Used by Portal to identify different Proxy nodes in
# metrics, logs and usage records. If empty, the Proxy runs without a fixed ID.
# Recommended: proxy-beijing-01, proxy-sg-01, proxy-us-east-01, etc.
SERVER_ID=

# Server region. Reserved for future cross-region routing priority.
# Recommended: cn, sg, us-east, eu-west, etc.
SERVER_REGION=

# -----------------------------------------------------------------------------
# AUTH & SECURITY (CRITICAL: must be identical to Portal)
# -----------------------------------------------------------------------------
# DEPRECATED / UNUSED: Proxy no longer validates JWTs locally — all API keys
# are verified via the Portal validate API. This value is ignored and can be
# left unset. (Portal still uses its own JWT_SECRET for login sessions.)
# JWT_SECRET=

# Proxy ↔ Portal sync secret. Must be EXACTLY the same as Portal's PROXY_SYNC_SECRET.
# ❗ If different, Portal will reject sync and webhook requests with 403.
# Minimum 32 characters.
PROXY_SYNC_SECRET=your-sync-secret-min-32-chars-same-as-portal

# Admin secret for /admin/* endpoints. Can reuse PROXY_SYNC_SECRET.
ADMIN_SECRET=your-admin-secret-min-32-chars

# CORS allowed origins. Comma-separated list, e.g. https://portal.example.com,https://app.example.com
# Leave empty to allow all origins (not recommended for production).
ALLOWED_ORIGINS=

# Encryption key for upstream API key AES-256-GCM. Must be EXACTLY the same as Portal's ENCRYPTION_KEY.
# ❗ If different, upstream API keys decrypt to garbage; all requests fail with 503.
# Minimum 32 characters.
ENCRYPTION_KEY=your-encryption-key-min-32-chars-same-as-portal

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=60

# -----------------------------------------------------------------------------
# SIMULATE MODE (for testing without real upstream providers)
# -----------------------------------------------------------------------------
SIMULATE_ENABLED=false
SIMULATE_LATENCY_MS=100

# -----------------------------------------------------------------------------
# TEST / E2E
# -----------------------------------------------------------------------------
# Upstream API key used by tests/e2e-accessapi-verification.sh.
# Set this to a real upstream key for local verification; never commit it.
UPSTREAM_KEY=sk-your-upstream-key-here
