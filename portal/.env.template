# ============================================
# AI Platform Go (Portal) - Environment Template
# Copy this file to .env and fill in your values before running start.sh
# ============================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL password. Auto-generated on first run if .env does not exist.
# Must be ≥ 16 chars for production.
DB_PASSWORD=your-db-password-here
# PostgreSQL SSL mode: disable | prefer | require | verify-ca | verify-full
# Local/dev: disable. Production across AZ/VPN: require or higher.
DB_SSLMODE=disable
# Path to CA certificate for verify-ca / verify-full (optional)
DB_SSL_ROOT_CERT=

# -----------------------------------------------------------------------------
# REDIS (Portal)
# -----------------------------------------------------------------------------
# Portal 自身使用的 Redis。start.sh 会通过 docker-compose.portal.yml 自动启动。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Enable TLS for Redis. Local/dev: false. Production: true.
REDIS_TLS=false
REDIS_TLS_SKIP_VERIFY=false

# -----------------------------------------------------------------------------
# REDIS (Proxy)
# -----------------------------------------------------------------------------
# ai-proxy-go 独立使用的 Redis。生产环境必须与 Portal Redis 分离，避免把数据面
# 流量压到 Portal 管理面。start.sh 会通过 docker-compose.proxy.yml 自动启动。
# 独立部署 Proxy 时，把这些值拷贝到 ai-proxy-go/.env（Proxy 读取 REDIS_* 变量）。
PROXY_REDIS_HOST=redis-proxy
PROXY_REDIS_PORT=6379
PROXY_REDIS_HOST_PORT=6380
PROXY_REDIS_PASSWORD=
PROXY_REDIS_DB=0

# -----------------------------------------------------------------------------
# AUTH & SECURITY
# -----------------------------------------------------------------------------
# JWT signing secret for Portal login/session tokens (admin & user auth).
# PORTAL-LOCAL: Proxy no longer validates JWTs — all API keys are verified
# via the Portal validate API. Only relevant if you run multiple Portal
# replicas (then they must share it). Minimum 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-min-32-chars-portal-local

# Encryption key for upstream API key AES-256-GCM storage.
# ❗ DISTRIBUTED DEPLOYMENT: Portal and ALL Proxy nodes MUST use the SAME value.
# Minimum 32 characters. If lost, all encrypted upstream keys become unreadable.
ENCRYPTION_KEY=your-encryption-key-min-32-chars-same-on-all-nodes

# Proxy ↔ Portal sync secret. Used to sign webhook and sync requests.
# ❗ DISTRIBUTED DEPLOYMENT: Portal and ALL Proxy nodes MUST use the SAME value.
# Minimum 32 characters.
PROXY_SYNC_SECRET=your-sync-secret-min-32-chars-same-on-all-nodes

# Admin secret for /metrics and admin endpoints.
# Can reuse PROXY_SYNC_SECRET or set independently.
ADMIN_SECRET=your-admin-secret-min-32-chars

# Base URL of the Proxy admin API, used by Portal to validate bearer-type
# upstream keys (Bedrock ABSK... bearer keys are verified through the Proxy).
# ❗ DISTRIBUTED DEPLOYMENT: the default http://ai-proxy-go:8080 only resolves
# inside the single-host Docker stack; set this to the Proxy host's address
# (e.g. http://172.31.43.214:8080). Also see PROXY_CALLBACK_URLS below.
# PROXY_URL=http://ai-proxy-go:8080

# Comma-separated Proxy HTTPS callback URLs for sync/balance push events.
# ❗ DISTRIBUTED DEPLOYMENT: set to the Proxy host's address, not the default.
# PROXY_CALLBACK_URLS=http://ai-proxy-go:8080

# -----------------------------------------------------------------------------
# PROXY INSTANCE IDENTITY (for distributed deployment)
# -----------------------------------------------------------------------------
# Server instance ID. Used by Portal to identify different Proxy nodes in metrics/logs.
# If empty, auto-generated as "proxy-{uuid[:8]}".
# Recommended: set to descriptive name like "proxy-beijing-01", "proxy-sg-01".
SERVER_ID=
SERVER_REGION=

# -----------------------------------------------------------------------------
# ADMIN USER
# -----------------------------------------------------------------------------
# Default admin account created on first boot.
# In production (ADMIN_MODE=production), bootstrap refuses empty/short passwords
# and known default/template placeholders. Copy this file to .env and replace
# the placeholder before starting.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars
ADMIN_NAME=Admin

# Admin role ceilings for production. These are reported to the admin UI as limits.
# Recommendation: 2 super admins (primary + break-glass), 3 system admins to start.
# Raise MAX_SYSTEM_ADMINS to 5 only for a real 24/7 on-call rotation.
MAX_SUPER_ADMINS=2
MAX_SYSTEM_ADMINS=3
MAX_ADMINS=5

# Admin mode: development | production
# Production enforces stronger password and encryption key requirements.
ADMIN_MODE=production

# -----------------------------------------------------------------------------
# NETWORK & URL
# -----------------------------------------------------------------------------
# Portal internal URL. Proxy connects to this.
# Same-machine: http://127.0.0.1:3001
# Distributed:  http://<portal-server-ip>:3001
PORTAL_URL=http://127.0.0.1:3001

# External base URL (for cookie domain, email links, CORS Allow-Origin).
# Must match the domain users access in their browser.
APP_BASE_URL=https://your-domain.com

# CORS allowed origins (comma-separated).
# Empty = allow all origins (safe for reverse-proxy / same-site setups).
# Example: ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# SMTP (optional - for email notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# FILE STORAGE (enterprise application documents)
# -----------------------------------------------------------------------------
# Provider: local | s3 | minio
# local  = store files on local filesystem (dev/single-node)
# s3     = AWS S3 or any S3-compatible service
# minio  = MinIO object storage
FILE_STORAGE_PROVIDER=local

# Local storage root (only used when FILE_STORAGE_PROVIDER=local)
# In Docker, this should be a bind-mounted host directory, not inside the container.
FILE_STORAGE_LOCAL_ROOT=./uploads

# S3 / MinIO settings (used when FILE_STORAGE_PROVIDER=s3 or minio)
FILE_STORAGE_ENDPOINT=          # MinIO: http://minio:9000 ; AWS S3: leave empty
FILE_STORAGE_REGION=ap-southeast-1
FILE_STORAGE_BUCKET=ai-portal-uploads
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
FILE_STORAGE_USE_SSL=true
FILE_STORAGE_PATH_PREFIX=enterprise-apps

# Upload limits
FILE_MAX_SIZE_MB=10
FILE_MAX_TOTAL_MB_PER_APPLICATION=50
FILE_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# -----------------------------------------------------------------------------
# TEST ACCOUNTS (used by Playwright E2E and local test scripts)
# Defaults use example.com dummy addresses.
# -----------------------------------------------------------------------------
# Set to true to auto-create the three E2E accounts on startup.
# Leave false in production to avoid creating dummy accounts.
SEED_E2E_ACCOUNTS=false

E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=E2E_AdminPass123!
E2E_USER_EMAIL=e2e-user@example.com
E2E_USER_PASSWORD=E2E_TestPass123!
E2E_ENTERPRISE_EMAIL=e2e-enterprise@example.com
E2E_ENTERPRISE_PASSWORD=E2E_TestPass123!

# Optional: pre-generated admin JWT for tests that bypass UI login.
E2E_ADMIN_JWT_TOKEN=
