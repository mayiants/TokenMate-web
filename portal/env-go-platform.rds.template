# ============================================================================
# ai-portal-go — RDS (Singapore) TEMPLATE for .env.go-platform
# ----------------------------------------------------------------------------
# Commit-safe: every secret is a placeholder. Do NOT put real values here.
# (Filename has no leading dot so it is not treated as a live secret file.)
#
# How to use on the NEW ap-southeast-1 host:
#   1) Decrypt local-config.secure.enc and take the REAL
#      workspace/ai-portal-go/.env.go-platform from it (it already works single-host).
#   2) Copy it to /opt/ai-platform/ai-portal-go/.env.go-platform
#   3) Flip ONLY the keys under "[A] change for Singapore/RDS" below.
#   4) Confirm secrets under "[B] inject from bundle" are present (they already are
#      if you started from the bundle file) — never regenerate ENCRYPTION_KEY etc.
#   5) Leave everything under "[C] keep as-is" untouched.
# Then:  ./start.sh mvp --app-base-url=https://api.woodgit.com
#
# Companion docs:
#   - docs/singapore-migration-stage2-rds-202607110542.md (single-EC2 plan)
#   - docs/singapore-migration-stage3-split-proxy-202607110942.md (split EC2, current)
# ============================================================================

# ----------------------------------------------------------------------------
# [A] CHANGE for Singapore / RDS
# ----------------------------------------------------------------------------
DB_HOST=<RDS_WRITER_ENDPOINT>                 # e.g. ai-portal-db.xxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ai_proxy_portal
DB_USER=postgres
DB_PASSWORD=<RDS_MASTER_PASSWORD>             # the NEW password set at rds create-db-instance
DB_SSLMODE=verify-full                        # minimum: require ; recommended: verify-full
DB_SSL_ROOT_CERT=/opt/ai-platform/certs/rds-ca.pem

APP_BASE_URL=https://api.woodgit.com
ALLOWED_ORIGINS=https://api.woodgit.com
SERVER_ID=portal-apse1-01
SERVER_REGION=ap-southeast-1

ADMIN_MODE=production
SEED_E2E_ACCOUNTS=false
SEED_TEST_ENTERPRISE=false
REDIS_TLS=false                               # container redis on same host; true only if moving to ElastiCache
REDIS_TLS_SKIP_VERIFY=false

# ----------------------------------------------------------------------------
# [B] INJECT FROM SECURE BUNDLE (copy verbatim; NEVER regenerate)
#     These already hold real values in the bundle's .env.go-platform.
# ----------------------------------------------------------------------------
ENCRYPTION_KEY=<FROM_SECURE_BUNDLE>           # IMMUTABLE: changing it breaks all stored upstream keys
JWT_SECRET=<FROM_SECURE_BUNDLE>
PROXY_SYNC_SECRET=<FROM_SECURE_BUNDLE>        # == PORTAL_SYNC_SECRET
ADMIN_SECRET=<FROM_SECURE_BUNDLE>

ADMIN_EMAIL=<FROM_SECURE_BUNDLE>
ADMIN_PASSWORD=<FROM_SECURE_BUNDLE>           # bootstrap skips if admin already exists in DB
ADMIN_NAME=<FROM_SECURE_BUNDLE>

REDIS_PASSWORD=<FROM_SECURE_BUNDLE>
PROXY_REDIS_PASSWORD=<FROM_SECURE_BUNDLE>

SMTP_HOST=<FROM_SECURE_BUNDLE>
SMTP_PORT=<FROM_SECURE_BUNDLE>
SMTP_SECURE=<FROM_SECURE_BUNDLE>
SMTP_USER=<FROM_SECURE_BUNDLE>
SMTP_PASSWORD=<FROM_SECURE_BUNDLE>
SMTP_FROM=<FROM_SECURE_BUNDLE>

# E2E / test-enterprise seeds: disabled in production (SEED_*=false above); values may stay blank
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ENTERPRISE_EMAIL=
E2E_ENTERPRISE_PASSWORD=
TEST_ENTERPRISE_NAME=
TEST_ENTERPRISE_ADMIN_EMAIL=
TEST_ENTERPRISE_MEMBER_EMAIL=
TEST_ENTERPRISE_PASSWORD=

# ----------------------------------------------------------------------------
# [C] KEEP AS-IS from the bundle (single-host wiring that start.sh consumes)
#     Listed for completeness; do not change unless you know the impact.
# ----------------------------------------------------------------------------
PORTAL_PORT=3001
PROXY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
PROXY_REDIS_HOST=<KEEP_FROM_BUNDLE>
PROXY_REDIS_PORT=<KEEP_FROM_BUNDLE>
PROXY_REDIS_HOST_PORT=<KEEP_FROM_BUNDLE>
PROXY_REDIS_DB=<KEEP_FROM_BUNDLE>
PROXY_CALLBACK_URLS=<KEEP_FROM_BUNDLE>        # single-host: http://ai-proxy-go:8080 ; split EC2: http://<PROXY_PRIVATE_IP>:8080
PORTAL_URL=<KEEP_FROM_BUNDLE>                 # single-host: http://ai-portal-go:3001 ; split EC2: http://<PORTAL_PRIVATE_IP>:3001
GOPROXY=<KEEP_FROM_BUNDLE>                    # e.g. https://proxy.golang.org,direct
APK_MIRROR=<KEEP_FROM_BUNDLE>                 # e.g. dl-cdn.alpinelinux.org
